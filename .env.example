APP_URL=http://localhost:4242
PORT=4242

# Stripe: use test keys locally, live keys on Render.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. If omitted, the app creates a $5 inline Checkout price.
STRIPE_PRICE_ID=
APP_PRICE_CENTS=500

# License storage. On Render, keep this on the persistent disk.
DATA_DIR=/opt/render/project/src/storage

# Email recovery. If omitted, recovery emails are logged in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Timebox YouTube Blocker <support@example.com>"
